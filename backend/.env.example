# Copy to .env and fill in real values. NEVER commit .env.

# --- Database ---
DATABASE_URL=postgresql+psycopg2://styleloop:styleloop@localhost:5432/styleloop

# --- Redis / RQ ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (private buckets, signed URLs only) ---
STORAGE_BUCKET=styleloop-media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT_URL=
STORAGE_REGION=us-east-1

# --- External APIs ---
OPENWEATHER_API_KEY=
FASHN_API_KEY=

# --- Vision tagging (Gemini API) ---
GEMINI_API_KEY=
VISION_MODEL=gemini-3.5-flash-lite

# --- Background removal fallback (used if local rembg is unavailable/fails) ---
DEEPAI_API_KEY=
FABRIC_CONFIDENCE_THRESHOLD=0.5

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173
# Additionally allow origins matching this regex (Vercel preview deployments).
# Full-matched against the Origin header. Leave blank to allow only FRONTEND_ORIGIN.
FRONTEND_ORIGIN_REGEX=https://styleloop-[a-z0-9-]+\.vercel\.app
